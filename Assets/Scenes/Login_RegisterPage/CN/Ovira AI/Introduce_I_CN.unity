    - rid: 2781876759092527641
      type: {class: SelectableFObject, ns: DA_Assets.FCU, asm: DA_Assets.FCU}
      data:
        id: 124:1143
        name: "\u5728\u7121\u7DDA\u5149\u901A\u8A0A\u7684\u4E16\u754C\u88E1\uFF0C\u8A0A\u865F\u7684\u50B3\u905E\u5F80\u5F80\u6BD4\u8A9E\u8A00\u66F4\u7CBE\u6E96\uFF1B\L\u7136\u800C\uFF0C\u5C0D\u591A\u6578\u521D\u5B78\u8005\u800C\u8A00\uFF0C\u5149\u7684\u904B\u884C\u537B\u662F\u96E3\u4EE5\u89F8\u53CA\u7684\u62BD\u8C61\u3002\LOptiVerse
          \u7684\u8A95\u751F\uFF0C\u6B63\u662F\u70BA\u4E86\u89E3\u6C7A\u9019\u500B\u5B78\u7FD2\u65B7\u5C64\u3002
          \u9019\u6B3E App \u7684\u524D\u8EAB\uFF0C\u662F\u6211\u65BC\u7814\u7A76\u6240\u968E\u6BB5\u6240\u958B\u767C\u7684\u4E00\u5957\u865B\u64EC\u5149\u7E96\u6A21\u64EC\u7CFB\u7D71\u3002
          \u900F\u904E Unity \u5F15\u64CE\uFF0C\u6211\u69CB\u5EFA\u4E86\u4E00\u500B\u53EF\u4EE5\u6A21\u64EC\u5F4E\u66F2\u640D\u8017\u3001\u9023\u63A5\u7570\u5E38\u8207\u5149\u8DEF\u50B3\u8F38
          \u72C0\u614B\u7684\u4E92\u52D5\u74B0\u5883\u3002\u539F\u59CB\u76EE\u6A19\u662F\u5E6B\u52A9\u521D\u5B78\u8005\u5728\u7DDA\u4E0A\u9032\u884C\u5BE6\u9A57\u6A21\u64EC\uFF0C\u7406\u89E3\u7406\u8AD6
          \u8207\u5BE6\u4F5C\u4E4B\u9593\u7684\u5C0D\u61C9\u95DC\u4FC2\u3002\u9019\u500B\u5C08\u6848\u4E0D\u50C5\u6210\u529F\u63D0\u5347\u4E86\u6559\u5B78\u4E92\u52D5\u6027\uFF0C\u4E5F\u7A2E\u4E0B\u4E86
          \u6211\u5C0D\u6578\u4F4D\u5316\u5DE5\u7A0B\u6559\u80B2\u7684\u6DF1\u523B\u95DC\u6CE8\u3002
          \u7136\u800C\uFF0C\u5149\u901A\u8A0A\u7684\u5B87\u5B99\uFF0C\u9060\u6BD4\u55AE\u4E00\u6A21\u64EC\u66F4\u5EE3\u95CA\u3002\L
          \u6211\u958B\u59CB\u601D\u8003\uFF1A\u5982\u679C\u9019\u6B3E App \u4E0D\u53EA\u662F\u5BE6\u9A57\u6A21\u64EC\u5DE5\u5177\uFF0C\u800C\u662F\u4E00\u500B\u80FD\u5F15\u5C0E\u3001\u4E92\u52D5
          \u3001\u8A55\u4F30\u8207\u81EA\u5B78\u7684\u5B8C\u6574\u5E73\u53F0\uFF0C\u5B83\u662F\u5426\u80FD\u5FB9\u5E95\u6539\u8B8A\u5DE5\u7A0B\u6559\u5B78\u7684\u9762\u8C8C\uFF1F
          \u9019\u6A23\u7684\u601D\u8003\u50AC\u751F\u4E86 OptiVerse\u2014\u2014
          \u4E00\u500B\u4EE5\u300C\u5149\u300D\u70BA\u6838\u5FC3\u4E3B\u984C\u6240\u6253\u9020\u7684
          \u6578\u4F4D\u5B78\u7FD2\u5B87\u5B99\uFF08Optical + Universe\uFF09\uFF0C\u7D50\u5408\u6C89\u6D78\u5F0F\u6559\u5B78\u3001\u6A21\u64EC\u4E92\u52D5\u8207
          \u53EF\u64F4\u5C55\u7684\u5B78\u7FD2\u5834\u666F\uFF0C\u8B93\u62BD\u8C61\u7684\u7121\u7DDA\u5149\u901A\u8A0A\u6280\u8853\uFF0C\u6210\u70BA\u4EBA\u4EBA\u53EF\u7406\u89E3\u3001\u53EF\u64CD\u4F5C\u3001
          \u751A\u81F3\u6A02\u65BC\u63A2\u7D22\u7684\u77E5\u8B58\u9AD4\u9A57\u3002
          OptiVerse \u4E0D\u50C5\u5EF6\u7E8C\u4E86\u6211\u5728\u5B78\u8853\u7814\u7A76\u4E2D\u7684\u71B1\u60C5\uFF0C\u66F4\u878D\u5408\u4E86
          UI/UX \u8A2D\u8A08\u3001 \u904A\u6232\u5316\u601D\u7DAD\u8207\u6559\u80B2\u79D1\u6280\u7684\u8DE8\u754C\u7406\u5FF5\u3002\L
          \u6211\u5011\u7684\u4F7F\u547D\uFF0C\u662F\u8B93\u300C\u5149\u300D\u4E0D\u518D\u53EA\u662F\u770B\u5F97\u898B\uFF0C\u800C\u662F\u8B93\u6BCF\u4E00\u9053\u5149\uFF0C\u90FD\u80FD\u88AB
          \u5B78\u6703\u3001\u6A21\u64EC\u3001\u7406\u89E3\uFF0C\u4E26\u5275\u9020\u672A\u4F86\u3002"
        type: 15
        selected: 0
        childs: []
